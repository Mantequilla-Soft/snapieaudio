# Server Configuration
PORT=3000
NODE_ENV=production

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/snapieaudio
DB_NAME=snapieaudio

# IPFS Gateway Configuration (base URLs without /ipfs/ path)
# Local gateway for recently pinned files (try first for pinned_local status)
IPFS_LOCAL_GATEWAY=http://your-vps-ip:8080
# Public gateways for fallback and pinned_supernode files
IPFS_PRIMARY_GATEWAY=https://ipfs.io
IPFS_FALLBACK_GATEWAY_1=https://dweb.link
IPFS_FALLBACK_GATEWAY_2=https://cloudflare-ipfs.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# Heartbeats (/api/audio/play-beat) fire ~every LISTEN_BEAT_SECONDS per
# listener and many share one IP behind NAT, so they get a higher ceiling than
# other endpoints.
BEAT_RATE_LIMIT_MAX_REQUESTS=600

# Event-driven Listen Tracking
# Heartbeat interval (seconds) while audio is genuinely playing. Lower = finer
# measurement + more requests. The server caps the credit per beat regardless.
LISTEN_BEAT_SECONDS=3
# Same IP + track within this many minutes counts as one anonymous play.
PLAY_DEDUPE_MIN=30
# Same logged-in listener + track within this many minutes counts as one
# payable pay-per-listen credit (written to audio-listen-log).
LISTEN_DEDUPE_MIN=30
# Optional heartbeat obfuscation. When set, /play-beat bodies must be
# AES-256-GCM ciphertext keyed off this value (the frontend must inject the
# SAME key as window.LISTEN_BEAT_KEY). Obfuscation only — the real anti-forge
# guarantee is the server-measured wall-clock between beats. Unset → plain JSON.
LISTEN_BEAT_KEY=

# Upload Configuration
# Accepts plain bytes (e.g. 104857600) or a unit suffix (e.g. 100mb, 1gb).
UPLOAD_MAX_FILE_SIZE=104857600
UPLOAD_ALLOWED_FORMATS=mp3,m4a,ogg,webm,wav
API_KEYS=your-api-key-here,sk_demo_xxx
DEMO_API_KEY=sk_demo_xxx

# IPFS Daemon API (for uploads - localhost only)
IPFS_API_URL=http://127.0.0.1:5001

# Admin Panel
ADMIN_PASSWORD=your-secure-password
